# Frontend
VITE_API_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=

# Database
# Docker Compose overrides this value with the local PostgreSQL container URL.
# Production: copy the pooled URL from Neon > Connect.
DATABASE_URL=postgresql://cognora:cognora@localhost:5432/cognora

# JWT security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key

# AI providers: NVIDIA NIM -> Gemini -> OpenRouter fallback
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local upload storage directory on the backend service.
# In production, keep this on a persistent disk if uploaded files must survive deploys.
UPLOAD_DIR=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_UNLIMITED=

# Pix manual
# Use uma chave aleatoria dedicada ao Cognora sempre que possivel.
PIX_KEY=
PIX_MERCHANT_NAME=COGNORA
PIX_MERCHANT_CITY=SAO PAULO
PIX_PRICE_CENTS_PRO=990
PIX_PRICE_CENTS_UNLIMITED=1990

# Admins que podem aprovar Pix manualmente, separados por virgula
ADMIN_EMAILS=

# Transactional email
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Frontend URL used in email links
APP_URL=http://localhost:5173

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173
