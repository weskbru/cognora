# Frontend
VITE_API_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=
# Em producao na Vercel, o proxy /api e usado por padrao. Defina true apenas
# se o frontend estiver em outro provedor e precisar chamar a API diretamente.
VITE_USE_DIRECT_API=false

# Database
# Docker Compose overrides this value with the local PostgreSQL container URL.
# Production: copy the pooled URL from Neon > Connect.
DATABASE_URL=postgresql://cognora:cognora@localhost:5432/cognora

# JWT security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key
ENVIRONMENT=development

# Browser session. Na Vercel, /api funciona como proxy same-origin; use cookies
# Secure + SameSite=lax em producao.
SESSION_COOKIE_NAME=cognora_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# AI providers: NVIDIA NIM -> Gemini -> OpenRouter fallback
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Limites do processamento assincrono de IA (segundos/jobs simultaneos).
AI_PROVIDER_TIMEOUT_SECONDS=45
AI_GENERATION_TIMEOUT_SECONDS=180
AI_GENERATION_MAX_CONCURRENCY=2
AI_JOB_STALE_MINUTES=10

# Local upload storage directory on the backend service.
# In production, keep this on a persistent disk if uploaded files must survive deploys.
UPLOAD_DIR=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_UNLIMITED=

# Pix manual
# Use uma chave aleatoria dedicada ao Cognora sempre que possivel.
PIX_KEY=
PIX_MERCHANT_NAME=COGNORA
PIX_MERCHANT_CITY=SAO PAULO
PIX_PRICE_CENTS_PRO=990
PIX_PRICE_CENTS_UNLIMITED=1990

# Admins que podem aprovar Pix manualmente, separados por virgula
ADMIN_EMAILS=

# Transactional email
RESEND_API_KEY=

# Observability interna (sem Sentry)
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_ALERT_EMAILS=
OBSERVABILITY_ALERT_ERROR_THRESHOLD=5
OBSERVABILITY_ALERT_WINDOW_MINUTES=10
OBSERVABILITY_ALERT_COOLDOWN_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=

# Frontend URL used in email links
APP_URL=http://localhost:5173

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173
